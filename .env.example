# Environment
# Local dev (unix socket, peer auth as current OS user):
DATABASE_URL=postgresql+psycopg2:///agent_platform
# Supabase (later):
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM — primary provider (any OpenAI-compatible chat.completions endpoint).
# Two common choices:

# (a) opencode API — many models (DeepSeek V4 Flash/Pro, MiniMax, Kimi, GLM,
#     Qwen, Mimo, Grok, GPT-5.6 Luna, ...) behind one key. Full catalog:
#     GET https://opencode.ai/zen/go/v1/models
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
DEFAULT_MODEL=deepseek-v4-flash

# (b) OpenRouter
# OPENAI_API_KEY=sk-or-v1-xxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MODEL=deepseek/deepseek-v4-flash

# Optional secondary provider — used automatically when the primary LLM call
# fails (rate limit / connection / 5xx) before any token is yielded.
#
# Default: OpenCode Zen FREE models — the demo keeps working for free when
# the paid primary is down/limited. KEY is optional: when
# OPENAI_FALLBACK_API_KEY is empty, the primary OPENAI_API_KEY is reused.
# Get a Zen key (free models cost $0) from https://opencode.ai/auth.
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_BASE_URL=https://opencode.ai/zen/v1
OPENAI_FALLBACK_MODEL=deepseek-v4-flash-free

# Other free Zen models you can use as OPENAI_FALLBACK_MODEL: hy3-free,
# mimo-v2.5-free, laguna-s-2.1-free, nemotron-3-ultra-free,
# nemotron-3.5-lightning-free, x-preview-f-free. To use a second paid provider
# instead, point OPENAI_FALLBACK_API_KEY/BASE_URL/MODEL at it (e.g. OpenRouter).

# Usage metering
# Daily cap (rolling usage_window_hours, default 24h). 0 = disabled.
# USAGE_WINDOW_HOURS=24
# USAGE_DAILY_TOKEN_LIMIT=0

# Session/weekly budget bars shown in the composer. Self-imposed demo limits
# for UX purposes — NOT tied to any real provider billing quota. Rolling
# windows: the countdown is the time until the oldest counted token ages out.
# Set to 0 to disable the bar and its 429 enforcement.
SESSION_TOKEN_LIMIT=50000
SESSION_TOKEN_WINDOW_HOURS=5
WEEKLY_TOKEN_LIMIT=500000
WEEKLY_TOKEN_WINDOW_HOURS=168

# --- Step 6: RAG / file upload (Part A) ---

# Embeddings — hosted Gemini API (free tier, no local model). Get a key at
# https://aistudio.google.com/apikey. Vectors are 768-dim (EMBED_DIM), so the
# pgvector column matches without migration.
GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768

# Supabase (Storage + Postgres)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=project-files

# Upload limits
MAX_UPLOAD_BYTES=10485760

# --- Optional web search (Tavily) ---
# Leave empty to disable web search: the web_search tool is then excluded
# from the tools offered to the model (never offered-then-failed).
TAVILY_API_KEY=
