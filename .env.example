# Environment
# Local dev (unix socket, peer auth as current OS user):
DATABASE_URL=postgresql+psycopg2:///agent_platform
# Supabase (later):
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM (OpenRouter — OpenAI-compatible)
OPENAI_API_KEY=sk-or-v1-xxxx
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# Default model used when a project has no explicit model
DEFAULT_MODEL=deepseek/deepseek-v4-flash
